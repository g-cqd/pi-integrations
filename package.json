{
  "name": "pi-integrations",
  "version": "0.1.0",
  "private": true,
  "description": "Modular Pi integrations for Claude, Codex, and Antigravity subscription sign-in plus Spettro and Mistral Vibe browser sign-in, with reusable authentication components. No API-key configuration.",
  "type": "module",
  "license": "MIT",
  "author": "Gigi (g-cqd)",
  "repository": {
    "type": "git",
    "url": "https://github.com/g-cqd/pi-integrations.git"
  },
  "homepage": "https://github.com/g-cqd/pi-integrations#readme",
  "bugs": {
    "url": "https://github.com/g-cqd/pi-integrations/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "oauth",
    "claude",
    "codex",
    "antigravity",
    "mistral"
  ],
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "test": "bun test",
    "check": "bunx --bun tsc --noEmit",
    "ci": "./scripts/ci.sh",
    "test:claude": "bun test test/claude",
    "test:spettro": "bun test test/spettro",
    "test:mistral-vibe": "bun test test/mistral-vibe",
    "test:shared": "bun test test/shared",
    "test:contracts": "bun test test/package",
    "test:coverage": "bun test --coverage",
    "verify:pricing": "bun scripts/verify-pricing.ts",
    "agy:extract-secret": "bun scripts/extract-agy-client-secret.ts",
    "test:codex": "bun test test/codex",
    "test:agy": "bun test test/agy"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "docs/"
  ],
  "exports": {
    "./shared": "./src/shared/index.ts",
    "./domains/claude": "./src/domains/claude/provider.ts",
    "./domains/claude/oauth": "./src/domains/claude/oauth.ts",
    "./domains/spettro": "./src/domains/spettro/provider.ts",
    "./domains/mistral-vibe": "./src/domains/mistral-vibe/provider.ts",
    "./domains/codex": "./src/domains/codex/provider.ts",
    "./domains/agy": "./src/domains/agy/provider.ts"
  },
  "pi": {
    "extensions": [
      "./src/domains/claude/index.ts",
      "./src/domains/codex/index.ts",
      "./src/domains/agy/index.ts",
      "./src/domains/spettro/index.ts",
      "./src/domains/mistral-vibe/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/bun": "^1.4.3",
    "@types/node": "^24.19.2",
    "typescript": "~5.9.0"
  }
}
